# Public DNS name or IPv4 address clients will connect to.
VPN_HOST=vpn.example.com

# WireGuard listens on UDP. UDP 443 is often useful when high-numbered UDP
# ports are blocked by a network or cloud firewall.
WG_PORT=443

# OpenVPN fallback listens on TCP.
OVPN_PORT=8443

# VPN subnets. Change only if they conflict with your local networks.
WG_SUBNET=10.66.0.0/24
WG_SERVER_IP=10.66.0.1/24
WG_CLIENT_IP=10.66.0.2/32

OVPN_SUBNET=10.77.0.0
OVPN_NETMASK=255.255.255.0
OVPN_CIDR=10.77.0.0/24

# Client profile name used in generated output filenames and OpenVPN certs.
CLIENT_NAME=phone

# Optional: force the public interface, for example eth0 or ens6.
# Leave empty to auto-detect the default route interface.
PUBLIC_INTERFACE=
